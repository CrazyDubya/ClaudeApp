def get_tool_definitions(schema: Optional[dict] = None) -> list[dict]:
    """
    Get tool definitions based on schema or defaults.

    Args:
        schema: Optional custom schema defining extraction fields

    Returns:
        List of tool definitions
    """
    if not schema:
        return EXTRACTION_TOOLS

    # Convert schema to tool definition
    return [
        {
            "name": "extract_custom",
            "description": "Extract information according to the provided schema",
            "input_schema": schema,
        }
    ]


def get_tools_for_document_type(doc_type: str) -> list[dict]:
    """
    Get appropriate tools based on document type.

    Args:
        doc_type: Type of document (contract, invoice, general)

    Returns:
        List of tool definitions
    """
    tools_map = {
        "contract": CONTRACT_TOOLS,
        "invoice": INVOICE_TOOLS,
        "general": EXTRACTION_TOOLS,
    }
    return tools_map.get(doc_type, EXTRACTION_TOOLS)
